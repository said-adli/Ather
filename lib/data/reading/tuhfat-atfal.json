  ],
  "importedAt": "2026-11-15",
  "chapters": [
    {
      "title": "النص",
      "sourceUrl": "https://ar.wikisource.org/w/index.php?oldid=594187",
      "revision": 594187,
      "blocks": [
        {
          "type": "paragraph",
          "text": "المقدمة"
        },
        {
          "type": "paragraph",
          "text": "(1)"
        },
        {
          "type": "paragraph",
          "text": "يَقُــولُ رَاجِـي رَحمةِ الْغَـفُـورِ"
        },
        {
          "type": "paragraph",
          "text": "دَوْمَـاً سُلَـيْمَانُ هُـوَ الْجَمـْزُورِى"
        },
        {
          "type": "paragraph",
          "text": "(2)"
        },
        {
          "type": "paragraph",
          "text": "الْحَمْــدُ لِلَّــهِ مُصَـلّـِياً عَـلـى"
        },
        {
          "type": "paragraph",
          "text": "مُـحَمَـــدٍ وآلِــهِ وَمَـنْ تَـلاَ"
        },
        {
          "type": "paragraph",
          "text": "(3)"
        },
        {
          "type": "paragraph",
          "text": "وَبَعْـدُ هـذَا النَّـظْـمُ لِلْـمُرِيــدِ"
        },
        {
          "type": "paragraph",
          "text": "فــي النُـونِ والتَّـنْوِينِ وَالْمُدُودِ"
        },
        {
          "type": "paragraph",
          "text": "(4)"
        },
        {
          "type": "paragraph",
          "text": "سَــمَّيتُــهُ بِتُحفَـة الأَطْفَالِ"
        },
        {
          "type": "paragraph",
          "text": "عَـنْ شَيْـخِنَا الْمِيـهِىِّ ذِي الْكَمالِ"
        },
        {
          "type": "paragraph",
          "text": "(5)"
        },
        {
          "type": "paragraph",
          "text": "أَرْجُــو بِـه أَنْ يَنْـفَعَ الطُّـلاَّبَـا"
        },
        {
          "type": "paragraph",
          "text": "وَالأَجْــرَ وَالْقَـبُـولَ وَالثَّـوَابـا"
        },
        {
          "type": "paragraph",
          "text": "النون الساكنة والتنوين"
        },
        {
          "type": "paragraph",
          "text": "(6)"
        },
        {
          "type": "paragraph",
          "text": "لِلـنُّــونِ إِنْ تَسْـكُنْ وَلِلتّـَنْوِينِ"
        },
        {
          "type": "paragraph",
          "text": "أَرْبَـعُ أَحْكَـامٍ فَخُـذْ تَبْـيِـيـنِـي"
        },
        {
          "type": "paragraph",
          "text": "(7)"
        },
        {
          "type": "paragraph",
          "text": "فَـالأَوَّلُ الإظْـهَارُ قَـبْـلَ أَحْـرُفِ"
        },
        {
          "type": "paragraph",
          "text": "لِلْحَـلْـقِ سِـتٍ رُتِّبَتْ فَلـتَـعْرِفِ"
        },
        {
          "type": "paragraph",
          "text": "(8)"
        },
        {
          "type": "paragraph",
          "text": "هَمْـزٌ فَـهَـاءٌ ثُـمَّ عَـيْـنٌ حَـاءُ"
        },
        {
          "type": "paragraph",
          "text": "مُـهْمَلَـتَانِ ثُــمَّ غَيْـنٌ خَــاءُ"
        },
        {
          "type": "paragraph",
          "text": "(9)"
        },
        {
          "type": "paragraph",
          "text": "والـثّـَانـي إِدْغَـامٌ بِسـتَّةٍ أَتَـتْ"
        },
        {
          "type": "paragraph",
          "text": "فِـي يَـرْمَـلُـونَ عِنْدَهُمْ قَدْ ثَبَتَتْ"
        },
        {
          "type": "paragraph",
          "text": "(10)"
        },
        {
          "type": "paragraph",
          "text": "لَـكِنَّهَا قِسْـمَانِ قِسْــمٌ يُـدْغَـمَا"
        },
        {
          "type": "paragraph",
          "text": "فِـيهِ بِـغُـنّـَةٍ بِيَـنْـمُو عُلِـمَـا"
        },
        {
          "type": "paragraph",
          "text": "(11)"
        },
        {
          "type": "paragraph",
          "text": "إِلاَّ إِذَا كَـانَـا بِـكــِلْمَـةٍ فَــلاَ"
        },
        {
          "type": "paragraph",
          "text": "تُـدْغِـمْ كَدُنْـيَا ثُمَّ صِـنْوَانٍ تَـلاَ"
        },
        {
          "type": "paragraph",
          "text": "(12)"
        },
        {
          "type": "paragraph",
          "text": "وَالثَّـانـي إِدْغَــامٌ بِغَيْــرِ غُـنَّةْ"
        },
        {
          "type": "paragraph",
          "text": "فـي الـلاَّمِ وَالـرَّا ثُـمَّ كَـرّرَنَّـهْ"
        },
        {
          "type": "paragraph",
          "text": "(13)"
        },
        {
          "type": "paragraph",
          "text": "وَّالثَـالـثُ الإِقْـلاَبُ عِنْـدَ الْبَـاءِ"
        },
        {
          "type": "paragraph",
          "text": "مِيــماً بِغُـنَــةٍ مَـعَ الإِخْـفَـاءِ"
        },
        {
          "type": "paragraph",
          "text": "(14)"
        },
        {
          "type": "paragraph",
          "text": "وَالرَّابِـعُ الإِخْـفَاءُ عِنْـدَ الْفاضِـلِ"
        },
        {
          "type": "paragraph",
          "text": "مِـنَ الحُـرُوفِ وَاجِـبٌ لِلْفَاضِـلِ"
        },
        {
          "type": "paragraph",
          "text": "(15)"
        },
        {
          "type": "paragraph",
          "text": "فـي خَمْسَـةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا"
        },
        {
          "type": "paragraph",
          "text": "فِـي كِلْمِ هذَا البَيْتِ قَـدْ ضَمَّنـْتُـهَا"
        },
        {
          "type": "paragraph",
          "text": "(16)"
        },
        {
          "type": "paragraph",
          "text": "صِفْ ذَا ثَـنَا كَمْ جَادَ شَخْصٌ قَدْ سمَا"
        },
        {
          "type": "paragraph",
          "text": "دُمْ طَيّـَباً زِدْ فِي تُـقَىً ضَعْ ظَالِـمَا"
        },
        {
          "type": "paragraph",
          "text": "الميم والنون المشددتين"
        },
        {
          "type": "paragraph",
          "text": "(17)"
        },
        {
          "type": "paragraph",
          "text": "وَغُـنَّ مِيـماً ثُـمَّ نُونـاً شُــدِّدَا"
        },
        {
          "type": "paragraph",
          "text": "وَسَــمِّ كُـلاً حَـرْفَ غُـنَّةٍ بَـدَا"
        },
        {
          "type": "paragraph",
          "text": "الميم الساكنة"
        },
        {
          "type": "paragraph",
          "text": "(18)"
        },
        {
          "type": "paragraph",
          "text": "وَالِميـمُ إِنْ تَسْـكُنْ تَجِى قَبْلَ الْهِجَا"
        },
        {
          "type": "paragraph",
          "text": "لاَ أَلــفٍ لَيِّــنَةٍ لِــذِى الْحِـجَا"
        },
        {
          "type": "paragraph",
          "text": "(19)"
        },
        {
          "type": "paragraph",
          "text": "أَحْـكَامُـهَا ثَـلاَثَـةٌ لِمَـنْ ضَبَـطْ"
        },
        {
          "type": "paragraph",
          "text": "إِخْـفَاءٌ ادْغَـامٌ وَإِظْـهَـارٌ فَقَــطْ"
        },
        {
          "type": "paragraph",
          "text": "(20)"
        },
        {
          "type": "paragraph",
          "text": "فَـالأَوَّلُ الإِخْـفَـاءُ عِنْـدَ الْبَــاءِ"
        },
        {
          "type": "paragraph",
          "text": "وَسَـمِّـهِ الشَّفْــوِىَّ لِلْـقُــرَّاءِ"
        },
        {
          "type": "paragraph",
          "text": "(21)"
        },
        {
          "type": "paragraph",
          "text": "وَالثّـَانـى إِدْغَـامٌ بِمِـثْلِـهَا أَتَـى"
        },
        {
          "type": "paragraph",
          "text": "وَسَـمِّ إدغـاماً صَـغـِيراً يَا فَـتَى"
        },
        {
          "type": "paragraph",
          "text": "(22)"
        },
        {
          "type": "paragraph",
          "text": "وَالثـَّالِـثُ الإِظْـهَارُ فِـى الْبَقِيَّـةْ"
        },
        {
          "type": "paragraph",
          "text": "مِـنْ أَحْـرُفٍ وَسَـمِّـهَا شَفْوِيَّـهْ"
        },
        {
          "type": "paragraph",
          "text": "(23)"
        },
        {
          "type": "paragraph",
          "text": "وَاحْـذَرْ لَدَى وَاوٍ وَفَـا أَنْ تَخْتَـفىِ"
        },
        {
          "type": "paragraph",
          "text": "لِـقُـرْبِــهَا وَلاتحادِ فَاعْـرِفِ"
        },
        {
          "type": "paragraph",
          "text": "لام آل ولام الفعل"
        },
        {
          "type": "paragraph",
          "text": "(24)"
        },
        {
          "type": "paragraph",
          "text": "لِلاَمِ أَلْ حَـالاَنِ قَـبْـلَ الأَحْــرُفِ"
        },
        {
          "type": "paragraph",
          "text": "أُولاَهُــمَا إِظْـهَـارُهَا فَلْتـَعْـرِفِ"
        },
        {
          "type": "paragraph",
          "text": "(25)"
        },
        {
          "type": "paragraph",
          "text": "قَبْلَ ارْبَـعٍ مَعْ عَشْرَةٍ خُـذْ عِلْمَـهُ"
        },
        {
          "type": "paragraph",
          "text": "مِنَ ابْـغِ حَجَّـكَ وَخَـفْ عَقِيـمـهُ"
        },
        {
          "type": "paragraph",
          "text": "(26)"
        },
        {
          "type": "paragraph",
          "text": "ثَانِيـهِـمَا إِدْغَـامُـهَا فـى أَرْبَـعٍ"
        },
        {
          "type": "paragraph",
          "text": "وَعَـشْـرَةٍ أَيْـضاً وَرَمْـزَهَا فَـعِ"
        },
        {
          "type": "paragraph",
          "text": "(27)"
        },
        {
          "type": "paragraph",
          "text": "طِبْ ثُمَّ صِلْ رُحْمَاً تَفُـزْ ضِفْ ذَا نِعَم"
        },
        {
          "type": "paragraph",
          "text": "دَعْ سُـوءَ ظَنٍ زُرْ شَرِيـفَاً لِلْكَـرَم"
        },
        {
          "type": "paragraph",
          "text": "(28)"
        },
        {
          "type": "paragraph",
          "text": "وَاللاَّمَ الاُولَـى سَـمِّـهَا قَمْـرِيَّـهْ"
        },
        {
          "type": "paragraph",
          "text": "وَالـلاَّمَ الاُخْـرىَ سَمِّـهَا شَمْسِـيَّهْ"
        },
        {
          "type": "paragraph",
          "text": "(29)"
        },
        {
          "type": "paragraph",
          "text": "وأظْـهِـرَنَّ لاَمَ فِـعْــلٍ مُطْلَــقاً"
        },
        {
          "type": "paragraph",
          "text": "فـى نَحْـوِ قُلْ نَعَمْ وَقُلْـنَا وَالْتَقَـى"
        },
        {
          "type": "paragraph",
          "text": "المثلين والمتقاربين والمتجانسين"
        },
        {
          "type": "paragraph",
          "text": "(30)"
        },
        {
          "type": "paragraph",
          "text": "إِنْ فِي الصِّفَاتِ وَالمَخَـارِجِ اتَّفَـقْ"
        },
        {
          "type": "paragraph",
          "text": "حَـرْفَانِ فَالْمِثْـلاَنِ فِـيهِـمَا أَحَـقْ"
        },
        {
          "type": "paragraph",
          "text": "(31)"
        },
        {
          "type": "paragraph",
          "text": "وَإِنْ يَكُـونَا مَخْـرَجـا ًتَـقَـارَبَـا"
        },
        {
          "type": "paragraph",
          "text": "وَفـي الصِّـفَاتِ اخْتَـلَـفَا يُلَقَّــبَا"
        },
        {
          "type": "paragraph",
          "text": "(32)"
        },
        {
          "type": "paragraph",
          "text": "مُـتْـقَارِبَـيْنِ أَوْ يَكُــونَا اتَّفَـقَا"
        },
        {
          "type": "paragraph",
          "text": "فِـي مَـخْرَجٍ دُونَ الصِّفَاتِ حُقِّـقَا"
        },
        {
          "type": "paragraph",
          "text": "(33)"
        },
        {
          "type": "paragraph",
          "text": "بِالْمُتَجَانِسَــيْنِ ثُــمَّ إِنْ سـَكَـنْ"
        },
        {
          "type": "paragraph",
          "text": "أَوَّلُ كُـلٍّ فَالصَّـغِـيرَ سَـمِّـيَـنْ"
        },
        {
          "type": "paragraph",
          "text": "(34)"
        },
        {
          "type": "paragraph",
          "text": "أَوْ حُـرِّكَ الحَـرْفَـانِ فى كُلٍّ فَقُـلْ"
        },
        {
          "type": "paragraph",
          "text": "كُـلٌّ كَبِــيرُ وافْهَمَـنْـهُ بِالْمُـثُلْ"
        },
        {
          "type": "paragraph",
          "text": "أقسام المد"
        },
        {
          "type": "paragraph",
          "text": "(35)"
        },
        {
          "type": "paragraph",
          "text": "وَالمـَدُّ أَصْلِـىُّ وَ فَـرْعِــىٌّ لَـهُ"
        },
        {
          "type": "paragraph",
          "text": "وَسَــمِّ أَوَّلاً طَبِيـعِـيّاً وَهُـــو"
        },
        {
          "type": "paragraph",
          "text": "(36)"
        },
        {
          "type": "paragraph",
          "text": "مَـالاَ تَوَقُّـفٌ لَـهُ عَـلـى سَـبَبْ"
        },
        {
          "type": "paragraph",
          "text": "وَلابِـدُونِهِ الحُـرُوفُ تُجْـتَـلَـبْ"
        },
        {
          "type": "paragraph",
          "text": "(37)"
        },
        {
          "type": "paragraph",
          "text": "بلْ أَىُّ حَرْفٍ غَيْرُ هَمْزٍ أَوْ سُـكُونْ"
        },
        {
          "type": "paragraph",
          "text": "جَا بَعْـدَ مَـدٍّ فَالطَّبِــيِعىَّ يَكُـونْ"
        },
        {
          "type": "paragraph",
          "text": "(38)"
        },
        {
          "type": "paragraph",
          "text": "وَالآخَرُ الْفَرْعِـىُّ مَوْقُـوفٌ عَلـي"
        },
        {
          "type": "paragraph",
          "text": "سَـبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْـجَـلاً"
        },
        {
          "type": "paragraph",
          "text": "(39)"
        },
        {
          "type": "paragraph",
          "text": "حُـرُوفُــهُ ثَـــلاَثَـةٌ فَعِـيـهَا"
        },
        {
          "type": "paragraph",
          "text": "مِنْ لَفْـظِ وَاىٍ وَهْىَ فى نُوحِـيـهَا"
        },
        {
          "type": "paragraph",
          "text": "(40)"
        },
        {
          "type": "paragraph",
          "text": "وَالكَسْرُ قَبْـلَ الْيَا وَقَبْلَ الْواوِ ضَـمْ"
        },
        {
          "type": "paragraph",
          "text": "شَـرْطٌ وَفَـتْحٌ قَبْـلَ أَلفٍ يُلْتَــزَمْ"
        },
        {
          "type": "paragraph",
          "text": "(41)"
        },
        {
          "type": "paragraph",
          "text": "وَاللِّـينُ مِنْـهَا الْيَا وَوَاوٌ سَـكَـنَا"
        },
        {
          "type": "paragraph",
          "text": "إِنِ انْفِــتَاحٌ قَبْـلَ كُـلٍّ أُعْـلِـنَا"
        },
        {
          "type": "paragraph",
          "text": "أحكام المد"
        },
        {
          "type": "paragraph",
          "text": "(42)"
        },
        {
          "type": "paragraph",
          "text": "لِلْمَــدِّ أَحْـكَـامٌ ثَـلاَثَـةٌ تَـدُومْ"
        },
        {
          "type": "paragraph",
          "text": "وَهْـيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّـزُومْ"
        },
        {
          "type": "paragraph",
          "text": "(43)"
        },
        {
          "type": "paragraph",
          "text": "فَـوَاجِبٌ إِنْ جَـاءَ هَمْـزٌ بَعْدَ مَـدْ"
        },
        {
          "type": "paragraph",
          "text": "فِـي كِلْمَــةٍ وَذَا بِمُتَّصْــلٍ يُعَـدْ"
        },
        {
          "type": "paragraph",
          "text": "(44)"
        },
        {
          "type": "paragraph",
          "text": "وَجَـائـزٌ مَـدٌ وَقَصْـرٌ إِنْ فُصِـل"
        },
        {
          "type": "paragraph",
          "text": "كُـلٌّ بِكِلْمَــةٍ وَهَذَا المُـنْفَصِــلْ"
        },
        {
          "type": "paragraph",
          "text": "(45)"
        },
        {
          "type": "paragraph",
          "text": "وَمِثـْلُ ذَا إِنْ عَـرَضَ السُّـكُـونُ"
        },
        {
          "type": "paragraph",
          "text": "وَقْـفَاً كَتَعْـلَـمُـونَ نَسْـتَعِــينُ"
        },
        {
          "type": "paragraph",
          "text": "(46)"
        },
        {
          "type": "paragraph",
          "text": "أَوْ قُـدِّمَ الْهَمْـزُ عَـلَـي المَـدِّ وَذَا"
        },
        {
          "type": "paragraph",
          "text": "بَـدَلْ كَـآمَـنُوا وَإِيَـماناً خُــذَا"
        },
        {
          "type": "paragraph",
          "text": "(47)"
        },
        {
          "type": "paragraph",
          "text": "وَلاَزِمٌ إِنِ السُّـكُـونُ أُصِّــــلاَ"
        },
        {
          "type": "paragraph",
          "text": "وَصْلاَ وَوَقْـفاً بَعْـدَ مَـدٍّ طُــوّلاَ"
        },
        {
          "type": "paragraph",
          "text": "أقسام المد اللازم"
        },
        {
          "type": "paragraph",
          "text": "(48)"
        },
        {
          "type": "paragraph",
          "text": "أَقْسَــامُ لاَزِمٍ لَـدَيهم أَرْبَـعَـةْ"
        },
        {
          "type": "paragraph",
          "text": "وَتِـلْكَ كِـلْمِـيُّ وَحَرْفِـيٌّ مَعَــهْ"
        },
        {
          "type": "paragraph",
          "text": "(49)"
        },
        {
          "type": "paragraph",
          "text": "كِـلاَهُـمَا مُـخَـفَّـفٌ مُـثَـقَّـلُ"
        },
        {
          "type": "paragraph",
          "text": "فَـهَـــذِهِ أَرْبَـعَـةٌ تُـفَصَّــلُ"
        },
        {
          "type": "paragraph",
          "text": "(50)"
        },
        {
          "type": "paragraph",
          "text": "فَـإِنْ بِـكِلْمَـةٍ سُـكُونٌ اجْـتَمَـعْ"
        },
        {
          "type": "paragraph",
          "text": "مَـعْ حَرْفِ مَـدٍّ فَهْوَ كِلْمِـيُّ وَقَـعْ"
        },
        {
          "type": "paragraph",
          "text": "(51)"
        },
        {
          "type": "paragraph",
          "text": "أَوْ فـي ثُـلاَثِـيِّ الحُرُوفِ وُجِـدَا"
        },
        {
          "type": "paragraph",
          "text": "وَالمَـدُّ وَسْـطُهُ فَحَـرْفِــيٌّ بَـدَا"
        },
        {
          "type": "paragraph",
          "text": "(52)"
        },
        {
          "type": "paragraph",
          "text": "كِـلاَهُـمَا مُثَـــقّـلٌ إِنْ أُدْغِـمَا"
        },
        {
          "type": "paragraph",
          "text": "مَخَفَّـفٌ كُــلُّ إِذَا لَـمْ يُـدْغَـمَا"
        },
        {
          "type": "paragraph",
          "text": "(53)"
        },
        {
          "type": "paragraph",
          "text": "وَالـلاَّزِمُ الْحَـرفِـيُّ أَوَّلَ السُّــوَرْ"
        },
        {
          "type": "paragraph",
          "text": "وُجُـودُهُ وَفِـي ثَمَـانٍ انحَصَــرْ"
        },
        {
          "type": "paragraph",
          "text": "(54)"
        },
        {
          "type": "paragraph",
          "text": "يَـجْمَعُـهَا حُـرُوفُ كَمْ عَسَلْ نَقَصْ"
        },
        {
          "type": "paragraph",
          "text": "وَعَيْنُ ذُو وَجْهَـيْنِ والطُّولُ أَخَصْ"
        },
        {
          "type": "paragraph",
          "text": "(55)"
        },
        {
          "type": "paragraph",
          "text": "وَمَا سِوَي الحَرْفِ الثُّلاَثِي لاَ أَلِـفْ"
        },
        {
          "type": "paragraph",
          "text": "فـَمُـدُّه مَـدّاً طَبِيـعِـيَّا أُلِــفْ"
        },
        {
          "type": "paragraph",
          "text": "(56)"
        },
        {
          "type": "paragraph",
          "text": "وَذَاكَ أَيْضـاً فِـي فَـوَاتِحِ السُّـوَرْ"
        },
        {
          "type": "paragraph",
          "text": "فِي لَفْظِ حَيٍّ طَـاهِرٍ قَـدِ انْحَصَـرْ"
        },
        {
          "type": "paragraph",
          "text": "(57)"
        },
        {
          "type": "paragraph",
          "text": "وَيَجْمَـعُ الْفَوَاتِـحَ الأَرْبَـعْ عَشَـرْ"
        },
        {
          "type": "paragraph",
          "text": "صِلْهُ سُحَيْراً مَنْ قَطَعْك ذَا اشْـتَهَرْ"
        },
        {
          "type": "paragraph",
          "text": "الخاتمة"
        },
        {
          "type": "paragraph",
          "text": "(58)"
        },
        {
          "type": "paragraph",
          "text": "وَتَــمَّ ذَا النَّـظْمُ بِحَـمْدِ اللَّـــهِ"
        },
        {
          "type": "paragraph",
          "text": "عَـلَـى تَمَامِـهِ بِـلاَ تَــنَاهِـى"
        },
        {
          "type": "paragraph",
          "text": "(59)"
        },
        {
          "type": "paragraph",
          "text": "أَبْـيَاتُـهُ نَـدٌّ بَـداَ لِـذِى النُّـهَى"
        },
        {
          "type": "paragraph",
          "text": "تَارِيخُهُ بُشْـرَى لِمَـنْ يُـتْقِـنُـهَا"
        },
        {
          "type": "paragraph",
          "text": "(60)"
        },
        {
          "type": "paragraph",
          "text": "ثُـمَّ الصَّـلاَةُ وَالسَّــلاَمُ أَبَـــداَ"
        },
        {
          "type": "paragraph",
          "text": "عِـلـى خِـتَامِ الأَنْبِـيَاءِ أَحْـمَـدَا"
        },
        {
          "type": "paragraph",
          "text": "(61)"
        },
        {
          "type": "paragraph",
          "text": "وَالآلِ وَالصَّــحْبِ وَكُـلِّ تَـابِـعِ"
        },
        {
          "type": "paragraph",
          "text": "وَكُــلِّ قَـارِئٍ وكُـلِّ سَــامِـعِ"
        }
      ]
    }
  ]
}
